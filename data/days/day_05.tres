[resource]
script = ExtResource("23_day_data")
day_number = 5
active_rules = Array[ExtResource("1_rule_data")]([ExtResource("2_r_baseline"), ExtResource("3_r_residue"), ExtResource("4_r_chem_residue"), ExtResource("5_r_multilayer"), ExtResource("6_r_flammable"), ExtResource("7_r_alu_always")])
