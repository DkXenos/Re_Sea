box_item = ExtResource("22_mystery_box")
box_spawn_count = 2
box_contents_min = 2
box_contents_max = 3
quota = 12
budget = 160
available_tools = Array[StringName]([&"rinse", &"magnifier", &"swab", &"cutter"])
initial_seed_fraction = 0.4
spawn_interval_min = 8.0
spawn_interval_max = 14.0
min_available_items = 2
intro_text = "Aturan bertambah dan barang bertambah, tapi waktu shift hampir sama. Perhatikan aturan aluminium yang baru."
