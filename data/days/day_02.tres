spawn_interval_min = 8.0
spawn_interval_max = 14.0
min_available_items = 2
intro_text = "Alat periksa datang. Bilas untuk melihat sisa kotoran, kaca pembesar untuk membaca kode. Keduanya memakai waktu shift."
