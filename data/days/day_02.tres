[resource]
script = ExtResource("13_day_data")
day_number = 2
active_rules = Array[ExtResource("1_rule_data")]([ExtResource("2_r_baseline"), ExtResource("3_r_residue")])
item_pool = Array[ExtResource("4_item_data")]([ExtResource("5_banana_peel"), ExtResource("6_fish_bone"), ExtResource("5_banana_peel"), ExtResource("7_pet_bottle"), ExtResource("8_juice_carton"), ExtResource("9_eco_tote"), ExtResource("10_alu_can"), ExtResource("11_car_battery")])
