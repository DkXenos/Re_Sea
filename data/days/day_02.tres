[resource]
script = ExtResource("17_day_data")
day_number = 2
active_rules = Array[ExtResource("1_rule_data")]([ExtResource("2_r_baseline"), ExtResource("3_r_residue")])
item_pool = Array[ExtResource("4_item_data")]([ExtResource("5_apel"), ExtResource("6_baju_organik"), ExtResource("7_banana_peel"), ExtResource("8_cangkang_telur"), ExtResource("9_daun"), ExtResource("10_baju_daur_ulang"), ExtResource("11_botol_kaca"), ExtResource("12_gelas_kertas_bersih"), ExtResource("13_kantong_plastik"), ExtResource("14_paper_cup"), ExtResource("15_tisu_b3")])
box_item = ExtResource("16_mystery_box")
box_spawn_count = 1
box_contents_min = 2
box_contents_max = 3
quota = 6
budget = 110
available_tools = Array[StringName]([&"rinse", &"magnifier", &"cutter"])
initial_seed_fraction = 0.4
spawn_interval_min = 8.0
spawn_interval_max = 14.0
min_available_items = 2
intro_text = "The kit arrives. Rinse finds residue, the magnifier reads codes - both spend shift time. The cutter does one thing only: it opens sealed crates, and that is free."
