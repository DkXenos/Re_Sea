[gd_resource type="Resource" script_class="RuleData" format=3]

[ext_resource type="Script" path="res://data/rule_data.gd" id="1_aglgl"]

[resource]
script = ExtResource("1_aglgl")
id = &"r_chem_residue"
text = "Engine oil, solvent paint or expired medicine turns whatever held it into hazardous waste. This rule beats the residue rule."
short_text = "Oil / paint / medicine residue  ->  HAZARDOUS"
applies_when = {
"residue_type": ["engine oil", "solvent-based paint", "expired medicine"]
}
forces_category = 2
priority = 40
