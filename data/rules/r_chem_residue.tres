[gd_resource type="Resource" script_class="RuleData" format=3]

[ext_resource type="Script" path="res://data/rule_data.gd" id="1_aglgl"]

[resource]
script = ExtResource("1_aglgl")
id = &"r_chem_residue"
text = "Engine oil, solvent paint, pesticide and expired medicine do not rinse off. Whatever they soaked into is hazardous waste. This rule beats the stain rule."
short_text = "Chemical stain, will not rinse  ->  HAZARDOUS"
applies_when = {
"stain_hazardous": true
}
forces_category = 2
priority = 40
