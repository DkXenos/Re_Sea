[gd_resource type="Resource" script_class="RuleData" format=3]

[ext_resource type="Script" path="res://data/rule_data.gd" id="1_f88a7"]

[resource]
script = ExtResource("1_f88a7")
id = &"r_residue"
text = "A stain still on it cannot be composted or recycled. Rinse it off and it is whatever it is made of again - leave it on and it goes in RESIDUE."
short_text = "Still stained  ->  RESIDUE"
applies_when = {
"is_stained": true
}
forces_category = 3
priority = 10
