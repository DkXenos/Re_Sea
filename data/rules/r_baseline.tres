[gd_resource type="Resource" script_class="RuleData" format=3]

[ext_resource type="Script" path="res://data/rule_data.gd" id="1_dmnmj"]

[resource]
script = ExtResource("1_dmnmj")
id = &"r_baseline"
text = "Sort by what it is made of: natural matter goes in ORGANIC; clean plastic, metal, glass and paper go in RECYCLABLE; chemicals go in HAZARDOUS; everything else goes in RESIDUE."
short_text = "What it is made of decides where it goes"
