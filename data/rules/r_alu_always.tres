[gd_resource type="Resource" script_class="RuleData" format=3]

[ext_resource type="Script" path="res://data/rule_data.gd" id="1_efgsv"]

[resource]
script = ExtResource("1_efgsv")
id = &"r_alu_always"
text = "Mulai hari ini aluminium selalu bisa didaur ulang, walaupun masih ada sisa kotoran. Aturan ini mengalahkan aturan sisa kotoran."
applies_when = {
"visible_material": ["aluminium"]
}
forces_category = 1
priority = 70
