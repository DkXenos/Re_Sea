[ext_resource type="Script" path="res://data/rule_data.gd" id="1_13lgy"]

[resource]
script = ExtResource("1_13lgy")
id = &"r_multilayer"
text = "Laminated packaging - paper, plastic and foil bonded together - cannot be separated, however clean it is. It goes in RESIDUE."
short_text = "Laminated packaging  ->  RESIDUE"
applies_when = {
"is_multilayer": true
}
forces_category = 3
priority = 30
