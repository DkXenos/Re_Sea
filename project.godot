; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Re:Sea"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
Game="*res://autoload/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/ui_theme.tres"
; the menu logo bobs 7px over 2.6s and the cutscene stills drift 5% over 14s.
; with control snapping on, both of those land on whole pixels and a motion
; that slow turns into a visible step every few frames - it reads as a bad
; framerate rather than as a drift. everything here is vector art on a
; canvas_items stretch, so there is nothing that needs pixel alignment.
common/snap_controls_to_pixels=false

