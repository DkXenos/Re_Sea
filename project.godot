; Engine configuration file.
; Underwater Claw + Waste Sorting - playable prototype.
; Constraints: Godot 4.x, GDScript only, 2D only, exactly two autoloads.

config_version=5

[application]

config/name="Cakar Laut"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Events="*res://autoload/events.gd"
Game="*res://autoload/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

claw_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
, Object(InputEventKey,"device":-1,"physical_keycode":4194319)
]
}
claw_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
, Object(InputEventKey,"device":-1,"physical_keycode":4194321)
]
}
claw_drop={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)
, Object(InputEventKey,"device":-1,"physical_keycode":83)
, Object(InputEventKey,"device":-1,"physical_keycode":4194322)
]
}
inspect_use={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)
]
}
rulebook={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82)
]
}
switch_view={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)
]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":73)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
]
}
advance={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194309)
, Object(InputEventMouseButton,"device":-1,"button_index":1)
]
}
debug_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194332)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
